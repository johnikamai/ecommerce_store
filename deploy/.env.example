CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_PAYMENTS=false
# Optional only for explicitly approved provider tests in local rehearsal:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ShopEase
