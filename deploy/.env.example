AUTH_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
RECOMMENDATION_DB_PASSWORD=
